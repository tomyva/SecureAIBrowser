<Window x:Class="SecureAIBrowser.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureAI Browser" Width="1200" Height="800" MinWidth="720" MinHeight="480">
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Grid.Column="0" Margin="0,0,4,0" Padding="10,4" Click="BackButton_Click" ToolTip="Back (Alt+Left)">Back</Button>
      <Button x:Name="ForwardButton" Grid.Column="1" Margin="0,0,4,0" Padding="10,4" Click="ForwardButton_Click" ToolTip="Forward (Alt+Right)">Forward</Button>
      <Button Grid.Column="2" Margin="0,0,4,0" Padding="10,4" Click="RefreshButton_Click" ToolTip="Refresh (Ctrl+R)">Refresh</Button>
      <Button Grid.Column="3" Margin="0,0,8,0" Padding="10,4" Click="HomeButton_Click">Home</Button>
      <TextBox x:Name="AddressBar" Grid.Column="4" VerticalContentAlignment="Center" Padding="8,4" KeyDown="AddressBar_KeyDown" ToolTip="Enter a web address or search term" />
    </Grid>
    <ProgressBar x:Name="LoadingProgress" DockPanel.Dock="Top" Height="3" IsIndeterminate="True" Visibility="Collapsed" />
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
    </StatusBar>
    <wv2:WebView2 x:Name="BrowserView" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" />
  </DockPanel>
</Window>
